     //infringements should be awarded.  Maybe later.
-    if ( ! this->isGoalie()
-         || M_goalie_catch_ban > 0
+    if ( this->isGoalie() &&
+         ( M_goalie_catch_ban > 0
          || ( M_stadium.playmode() != PM_PlayOn
               && ! Referee::isPenaltyShootOut( M_stadium.playmode() ) )
-         )
+         ))
     {
